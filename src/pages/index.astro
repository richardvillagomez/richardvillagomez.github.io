---
import Layout from "../layouts/Layout.astro";
import siteConfig from "../side.config";
import { Image } from "astro:assets";
import { Content as Bio } from "../data/bio.md";


const rawProfileImage = siteConfig.hero.profileImage.trim();
const profileImageUrl = /^https?:/i.test(rawProfileImage)
  ? rawProfileImage
  : rawProfileImage.startsWith("/")
    ? rawProfileImage
    : new URL(
        rawProfileImage.startsWith(".")
          ? rawProfileImage
          : `../${rawProfileImage}`,
        import.meta.url,
      ).href;

const name = siteConfig.author;
const description = siteConfig.hero.subheadline;
const profileAlt = siteConfig.hero.profileAlt || name;
---

<Layout
  title="Home"
  description={description}
  schemaType="ProfilePage"
>

  <section class="relative pb-9 pt-3 sm:pb-12 sm:pt-6">
    <div class="relative grid gap-6 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start lg:gap-x-14">
      <div class="min-w-0">
        <h1 class="sr-only">{name}</h1>

        <div class="home-bio max-w-[65ch] space-y-4 text-[1.0625rem] leading-7 text-ink-700 dark:text-paper-300">
          <Bio />
        </div>
      </div>

      <aside class="w-full lg:col-start-2 lg:row-start-1" aria-label="Profile">
        <div class="relative w-20 sm:w-24 overflow-hidden rounded-s p-1.5  sm:w-24 lg:w-full lg:p-2">
          <Image
            src={profileImageUrl}
            alt={profileAlt}
            width={siteConfig.hero.profileImageWidth || 160}
            height={siteConfig.hero.profileImageHeight || 160}
            layout="constrained"
            fit="cover"
            priority
            class="aspect-square h-auto w-full "
          />
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .home-bio :global(a) {
    font-weight: 600;
    color: #2f5363;
    text-decoration: underline;
    text-decoration-color: #96bdc9;
    text-underline-offset: 4px;
  }

  :global(.dark) .home-bio :global(a) {
    color: #96bdc9;
    text-decoration-color: #396779;
  }
</style>
