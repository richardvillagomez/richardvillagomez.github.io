---
import MarkdownPage from "../components/MarkdownPage.astro";
import { Content, getHeadings } from "../data/research.md";
import siteConfig from "../side.config";
---

<MarkdownPage
  title={siteConfig.pageTitles.researches.title || "Research"}
  description={siteConfig.pageTitles.researches.description}
  headings={getHeadings()}
  schemaType="CollectionPage"
>
  <Content />
</MarkdownPage>
