---
import MarkdownPage from "../components/MarkdownPage.astro";
import { Content, getHeadings } from "../data/about.md";
import siteConfig from "../side.config";
---

<MarkdownPage
  title={siteConfig.pageTitles.about.title || "About"}
  description={siteConfig.pageTitles.about.description}
  headings={getHeadings()}
  schemaType="AboutPage"
>
  <Content />
</MarkdownPage>
